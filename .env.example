# ============================================
# SUPERSET - VARIABLES DE ENTORNO
# ============================================
# IMPORTANTE: Copia este archivo a .env y modifica los valores
# NO COMMITEAR el archivo .env con credenciales reales

# ============================================
# SEGURIDAD - CLAVES SECRETAS
# ============================================
# Genera una clave segura con: openssl rand -base64 42
# IMPORTANTE: Usa claves diferentes para cada entorno
SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET_KEY
SUPERSET_SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET_KEY

# ============================================
# POSTGRESQL - BASE DE DATOS
# ============================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset_password_change_me
POSTGRES_DB=superset

# URI de conexión completa (se construye automáticamente)
DATABASE_DIALECT=postgresql
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_HOST=${POSTGRES_HOST}
DATABASE_PORT=${POSTGRES_PORT}
DATABASE_DB=${POSTGRES_DB}

# ============================================
# REDIS - CACHÉ Y CELERY
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CELERY_DB=1
REDIS_RESULTS_DB=2

# ============================================
# SUPERSET - CONFIGURACIÓN GENERAL
# ============================================
# Entorno: development, staging, production
SUPERSET_ENV=development

# Puerto de la aplicación
SUPERSET_PORT=8088

# Carga datos de ejemplo (true/false)
SUPERSET_LOAD_EXAMPLES=false

# ============================================
# USUARIO ADMINISTRADOR INICIAL
# ============================================
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_EMAIL=admin@superset.local
ADMIN_PASSWORD=admin_change_me_in_production

# ============================================
# CELERY - TAREAS ASÍNCRONAS
# ============================================
# Broker URL para Celery
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_CELERY_DB}
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_RESULTS_DB}

# Configuración de workers
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=128

# ============================================
# NGINX - PROXY REVERSO
# ============================================
# Dominio para SSL (usado solo con perfil ssl)
DOMAIN_NAME=superset.local

# Puerto externo de Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================
# Habilitar modo debug (solo desarrollo)
FLASK_DEBUG=false

# Habilitar recarga automática
FLASK_USE_RELOAD=true

# ============================================
# LÍMITES Y TIMEOUTS
# ============================================
# Timeout para queries SQL (segundos)
SQLLAB_TIMEOUT=300

# Timeout para queries asíncronas (segundos)
SQLLAB_ASYNC_TIME_LIMIT_SEC=21600

# Límite de filas por query
ROW_LIMIT=50000

# ============================================
# FEATURES FLAGS
# ============================================
# Habilitar alertas y reportes
SUPERSET_FEATURE_ALERT_REPORTS=false

# Habilitar thumbnails de dashboards
SUPERSET_FEATURE_THUMBNAILS=false

# Habilitar queries asíncronas globales
SUPERSET_FEATURE_GLOBAL_ASYNC_QUERIES=false

# ============================================
# LOGGING
# ============================================
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# MAPBOX (OPCIONAL)
# ============================================
# API Key para visualizaciones de mapas
# Obtener en: https://www.mapbox.com/
MAPBOX_API_KEY=

# ============================================
# SMTP - EMAIL (OPCIONAL)
# ============================================
# Configuración para envío de emails (alertas, reportes)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=superset
SMTP_PASSWORD=
SMTP_MAIL_FROM=superset@superset.local
